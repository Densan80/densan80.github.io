// DOM-элементы
const thicknessRange = document.getElementById('thicknessRange');
const thicknessInput = document.getElementById('thicknessInput');
const jointTypeSelect = document.getElementById('jointTypeSelect');
const jointsList = document.getElementById('jointsList');
const matchCount = document.getElementById('matchCount');

const weldDetails = document.getElementById('weldDetails');
const emptyState = document.getElementById('emptyState');
const weldCodeBadge = document.getElementById('weldCodeBadge');
const weldName = document.getElementById('weldName');
const eskdCode = document.getElementById('eskdCode');
const copyBtn = document.getElementById('copyBtn');

const paramS = document.getElementById('paramS');
const paramB = document.getElementById('paramB');
const paramAlpha = document.getElementById('paramAlpha');
const paramC = document.getElementById('paramC');
const weldDesc = document.getElementById('weldDesc');
const svgContainer = document.getElementById('svgContainer');

let selectedWeld = null;

// Инициализация
document.addEventListener('DOMContentLoaded', () => {
  updateSearch();

  // Синхронизация слайдера и инпута
  thicknessRange.addEventListener('input', (e) => {
    thicknessInput.value = e.target.value;
    updateSearch();
  });

  thicknessInput.addEventListener('input', (e) => {
    thicknessRange.value = e.target.value;
    updateSearch();
  });

  jointTypeSelect.addEventListener('change', updateSearch);

  copyBtn.addEventListener('click', () => {
    navigator.clipboard.writeText(eskdCode.textContent);
    const originalText = copyBtn.textContent;
    copyBtn.textContent = '✅ Скопировано!';
    setTimeout(() => { copyBtn.textContent = originalText; }, 1500);
  });
});

// Фильтрация и обновление списка
function updateSearch() {
  const currentS = parseFloat(thicknessInput.value) || 1;
  const currentGroup = jointTypeSelect.value;

  const matches = weldDatabase.filter(weld => {
    const isThicknessOk = currentS >= weld.sMin && currentS <= weld.sMax;
    const isGroupOk = currentGroup === 'ALL' || weld.group === currentGroup;
    return isThicknessOk && isGroupOk;
  });

  matchCount.textContent = matches.length;
  jointsList.innerHTML = '';

  if (matches.length === 0) {
    jointsList.innerHTML = '<span style="color: var(--text-muted); font-size: 0.85rem;">Нет подходящих швов</span>';
    weldDetails.classList.add('hidden');
    emptyState.classList.remove('hidden');
    return;
  }

  emptyState.classList.add('hidden');
  weldDetails.classList.remove('hidden');

  matches.forEach(weld => {
    const chip = document.createElement('button');
    chip.className = `joint-chip ${selectedWeld && selectedWeld.code === weld.code ? 'active' : ''}`;
    chip.textContent = `${weld.code}`;
    chip.title = weld.name;
    chip.addEventListener('click', () => selectWeld(weld));
    jointsList.appendChild(chip);
  });

  // Если выбранного шва нет в списке, выбираем первый доступный
  if (!selectedWeld || !matches.some(m => m.code === selectedWeld.code)) {
    selectWeld(matches[0]);
  } else {
    selectWeld(selectedWeld);
  }
}

// Отображение подробностей шва
function selectWeld(weld) {
  selectedWeld = weld;

  // Обновление подсветки чипов
  document.querySelectorAll('.joint-chip').forEach(chip => {
    chip.classList.toggle('active', chip.textContent === weld.code);
  });

  weldCodeBadge.textContent = weld.code;
  weldName.textContent = weld.name;
  eskdCode.textContent = `ГОСТ 5264-80-${weld.code}`;

  paramS.textContent = `${weld.sMin} – ${weld.sMax} мм`;
  paramB.textContent = weld.b;
  paramAlpha.textContent = weld.alpha;
  paramC.textContent = weld.c;
  weldDesc.textContent = weld.desc;

  renderSVG(weld);
}

